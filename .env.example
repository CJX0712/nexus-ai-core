# NexusAI 环境配置示例：复制为 .env 后按需填写（作者: 晨星）
# 全部变量均为可选；留空时系统自动降级为本地/离线实现，链路仍可跑通。

# ---------- 服务 ----------
NEXUS_ENV=development
NEXUS_HOST=0.0.0.0
NEXUS_PORT=8000
NEXUS_DATA_DIR=./data

# ---------- 模型网关 ----------
# auto（默认，自动降级） | openai_compat | llama_cpp | offline
NEXUS_LLM_PROVIDER=auto
# OpenAI 兼容端点根地址，例如：
#   OpenAI   https://api.openai.com/v1
#   DeepSeek https://api.deepseek.com/v1
#   通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地Ollama http://localhost:11434/v1
NEXUS_LLM_BASE_URL=
NEXUS_LLM_API_KEY=
NEXUS_LLM_MODEL=
NEXUS_LLM_TEMPERATURE=0.2
NEXUS_LLM_MAX_TOKENS=1024
NEXUS_LLM_TIMEOUT=60

# ---------- 本地 GGUF 兜底推理 ----------
NEXUS_LOCAL_GGUF_PATH=
NEXUS_LOCAL_CTX_SIZE=2048
NEXUS_LOCAL_THREADS=4

# ---------- 嵌入 ----------
# auto（fastembed -> OpenAI兼容 -> 哈希） | fastembed | openai_compat | hashing
NEXUS_EMBED_PROVIDER=auto
NEXUS_EMBED_MODEL=BAAI/bge-small-zh-v1.5
NEXUS_EMBED_DIM=512
NEXUS_EMBED_BASE_URL=
NEXUS_EMBED_API_KEY=

# ---------- 知识检索 ----------
NEXUS_CHUNK_SIZE=512
NEXUS_CHUNK_OVERLAP=64
NEXUS_TOP_K=4
NEXUS_HYBRID_ENABLED=true
NEXUS_RRF_K=60

# ---------- 智能体 / 记忆 ----------
NEXUS_AGENT_MAX_STEPS=6
NEXUS_MEMORY_MAX_TURNS=20
